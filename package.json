{
  "name": "bookleaf-author-support-portal",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": "^22.12.0 || ^24.0.0", "npm": ">=10" },
  "scripts": {
    "dev": "next dev",
    "build": "npm run db:generate && next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "npm run db:generate && next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run lint && npm run typecheck && npm test && npm run db:validate && npm run build",
    "env:check": "tsx scripts/check-env.ts",
    "env:check:demo": "tsx scripts/check-env.ts --demo",
    "data:validate": "tsx scripts/validate-data.ts",
    "db:generate": "prisma generate",
    "db:validate": "prisma validate",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:status": "tsx scripts/migrate.ts --status",
    "auth:provision": "tsx scripts/provision-authors.ts",
    "admin:bootstrap": "tsx scripts/bootstrap-admin.ts",
    "db:seed": "tsx scripts/seed.ts",
    "setup:verify": "tsx scripts/verify-setup.ts",
    "demo:setup": "tsx scripts/demo-setup.ts",
    "setup:safety": "tsx scripts/check-hosted-safety.ts",
    "test:hosted": "tsx scripts/test-hosted.ts",
    "test:tickets:hosted": "tsx scripts/test-tickets-hosted.ts",
    "test:smoke": "tsx scripts/test-local.ts",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.0.0",
    "@prisma/client": "^7.0.0",
    "@radix-ui/react-slot": "^1.2.3",
    "@supabase/ssr": "^0.8.0",
    "@supabase/supabase-js": "^2.0.0",
    "@tanstack/react-query": "^5.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.577.0",
    "next": "16.4.2",
    "openai": "^6.0.0",
    "pg": "^8.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.0.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@next/env": "16.4.2",
    "@playwright/test": "^1.0.0",
    "@tailwindcss/postcss": "^4.0.0",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "16.4.2",
    "prisma": "^7.0.0",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.9.0",
    "vitest": "^4.0.0"
  }
}
