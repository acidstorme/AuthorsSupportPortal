# Copy to .env.local. Never commit .env.local or real credentials.
# Use a separate hosted project for development and deployed demo.
# Bootstrap migrations need only APP_ENV, SUPABASE_PROJECT_REF and DIRECT_URL.
# Run npm run env:check -- development before npm run db:migrate -- development.
APP_ENV=development
APP_URL=http://localhost:3000
# Project Settings -> General; exactly the reference used by Auth and both DB URLs.
SUPABASE_PROJECT_REF=replace-me
# Project API URL and public publishable key (legacy anon key also supported).
NEXT_PUBLIC_SUPABASE_URL=https://replace-me.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=replace-me
# Runtime connection. Use a restricted DB login; percent-encode password special characters.
# May stay unset/placeholder until migration then scripts/sql/runtime-role.sql are applied.
# Afterwards configure runtime/Auth values and run bare npm run env:check.
# Copy the region/host from Supabase Connect; keep schema=app and TLS verification enabled.
DATABASE_URL=postgresql://bookleaf_runtime.replace-me:replace-me@aws-0-REGION.pooler.supabase.com:6543/postgres?schema=app&sslmode=verify-full
# Migration connection. Use direct DB host or session pooler port 5432 with DDL privileges.
DIRECT_URL=postgresql://postgres.replace-me:replace-me@aws-0-REGION.pooler.supabase.com:5432/postgres?schema=app&sslmode=verify-full
# AI is planned, not active through Milestone 4. mock needs no API key.
AI_MODE=mock
OPENAI_MODEL=gpt-4o-mini
OPENAI_API_KEY=
# Trusted provisioning only. Never deploy these variables to the Next.js runtime.
# Trusted Supabase service_role/secret key for Admin API. Never NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
# Approved disposable assignment credentials. NEVER reuse with real user data.
# Existing passwords are never reset by ordinary setup runs.
DEMO_AUTHOR_PASSWORD=Bookleaf123
DEMO_ADMIN1_EMAIL=admin1@email.com
DEMO_ADMIN2_EMAIL=admin2@email.com
DEMO_ADMIN_PASSWORD=Bookleaf123
# Explicitly approve ONLY an isolated hosted assignment project by repeating its ref.
DEMO_APPROVED_PROJECT_REF=
# Set true only after disabling signup and blocking outbound Auth emails (including recovery).
DEMO_EMAIL_DISABLED_CONFIRMED=false
